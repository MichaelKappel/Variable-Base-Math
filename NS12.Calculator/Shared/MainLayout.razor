@inherits LayoutComponentBase

<div class="shell">
    <header class="site-header">
        <div class="site-header__inner">
            <div class="site-brand">
                <a class="site-brand__link" href="/">
                    <span class="site-brand__eyebrow">Protocol5</span>
                    <span class="site-brand__title">Variable-Base Mathematics</span>
                </a>
                <p class="site-brand__tagline">Exact arithmetic, radix conversion, and math-first text obfuscation in one publishable shell.</p>
            </div>

            <nav class="site-nav" aria-label="Primary navigation">
                <a class="site-nav__link site-nav__link--external" href="/">Home</a>
                <NavLink class="site-nav__link" href="calculator">Calculator</NavLink>
                <NavLink class="site-nav__link" href="converter">Converter</NavLink>
                <NavLink class="site-nav__link" href="encryption">Encryption</NavLink>
                <a class="site-nav__link site-nav__link--external" href="/Fibonacci">Fibonacci</a>
                <a class="site-nav__link site-nav__link--external" href="/Prime">Primes</a>
            </nav>
        </div>
    </header>

    <main class="site-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <div>
                <p class="site-footer__title">Protocol5 mathematics</p>
                <p class="site-footer__copy">A public home for exact arithmetic, base conversion, Fibonacci sequence exploration, prime-number tools, and educational text obfuscation.</p>
            </div>

            <div class="site-footer__links" aria-label="Protocol5 links">
                <a href="calculator">Calculator</a>
                <a href="converter">Converter</a>
                <a href="encryption">Encryption</a>
                <a href="/Fibonacci">Fibonacci</a>
                <a href="/Prime">Primes</a>
                <a href="/Home/Links">Links</a>
                <a href="/Home/Contact">Contact</a>
            </div>
        </div>
    </footer>
</div>
