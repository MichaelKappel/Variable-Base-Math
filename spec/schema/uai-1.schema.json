{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol5.github.io/uai-1/schema/uai-1.schema.json",
  "title": "UAI-1 Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "version",
    "schemaVersion",
    "documentId",
    "source",
    "metadata",
    "structure",
    "semantics",
    "symbols",
    "assets",
    "relationships",
    "annotations",
    "provenance",
    "extensions"
  ],
  "properties": {
    "spec": {
      "const": "UAI-1"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "schemaVersion": {
      "$ref": "#/$defs/semver"
    },
    "documentId": {
      "$ref": "#/$defs/id"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "semantics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/semantic"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "literal"
      ],
      "properties": {
        "literal": {
          "type": "string"
        },
        "normalized": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isInferred"
      ],
      "properties": {
        "isInferred": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "isInferred": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "rationale",
              "confidence"
            ]
          }
        }
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": {
          "type": "string"
        },
        "xpath": {
          "type": "string"
        },
        "domPath": {
          "type": "string"
        },
        "htmlFragment": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "link",
            "submit",
            "button",
            "script",
            "unknown"
          ]
        },
        "target": {
          "type": "string"
        }
      }
    },
    "inputOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "metadataEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "tableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "headerRef": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tableCell"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "required",
          "payload"
        ],
        "properties": {
          "version": {
            "$ref": "#/$defs/semver"
          },
          "required": {
            "type": "boolean"
          },
          "payload": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "retrievedAt"
      ],
      "properties": {
        "uri": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "retrievedAt": {
          "$ref": "#/$defs/isoDateTime"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-z0-9-]+:[A-Fa-f0-9]+$"
        },
        "mimeType": {
          "type": "string"
        },
        "htmlLanguage": {
          "type": "string"
        },
        "canonicalUri": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language",
        "pageType"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "siteName": {
          "type": "string"
        },
        "pageType": {
          "type": "string",
          "enum": [
            "generic",
            "homepage",
            "article",
            "landing-page",
            "navigation",
            "symbolic-manuscript",
            "wordpress-page",
            "gallery",
            "glossary",
            "reference"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publishedAt": {
          "$ref": "#/$defs/isoDateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/isoDateTime"
        },
        "canonicalUrl": {
          "type": "string"
        },
        "alternateUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "uri",
        "mimeType"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "audio",
            "document",
            "embed",
            "icon",
            "file"
          ]
        },
        "uri": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-z0-9-]+:[A-Fa-f0-9]+$"
        },
        "title": {
          "type": "string"
        },
        "altText": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "decorative": {
          "type": "boolean"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "relation": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "targetId": {
          "$ref": "#/$defs/id"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targets",
        "kind",
        "value",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "kind": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "source",
            "translator-structural",
            "translator-semantic",
            "user",
            "system"
          ]
        },
        "inference": {
          "$ref": "#/$defs/inference"
        }
      }
    },
    "symbolGeometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primitives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symmetry": {
          "type": "string"
        },
        "closure": {
          "type": "string"
        }
      }
    },
    "symbolMeaning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "meaningType",
        "origin"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "meaningType": {
          "type": "string"
        },
        "origin": {
          "type": "string",
          "enum": [
            "source-provided",
            "inferred",
            "editorial"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visualForm",
        "meaning",
        "inference"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "visualForm": {
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/symbolGeometry"
        },
        "strokeLogic": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meaning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbolMeaning"
          }
        },
        "sourceSystem": {
          "type": "string"
        },
        "sourceEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceEvidence"
          }
        },
        "inference": {
          "$ref": "#/$defs/inference"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "agentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "translatorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "contractVersion",
        "mode"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "contractVersion": {
          "$ref": "#/$defs/semver"
        },
        "mode": {
          "type": "string"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "actor",
        "change"
      ],
      "properties": {
        "timestamp": {
          "$ref": "#/$defs/isoDateTime"
        },
        "actor": {
          "type": "string"
        },
        "change": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt"
      ],
      "properties": {
        "generatedAt": {
          "$ref": "#/$defs/isoDateTime"
        },
        "generator": {
          "$ref": "#/$defs/agentIdentity"
        },
        "translator": {
          "$ref": "#/$defs/translatorIdentity"
        },
        "sourceAuthors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/history"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "document",
            "section",
            "heading",
            "paragraph",
            "quote",
            "list",
            "listItem",
            "table",
            "image",
            "figure",
            "caption",
            "button",
            "link",
            "navigation",
            "form",
            "input",
            "glossaryEntry",
            "symbol",
            "glyphCluster",
            "diagram",
            "manuscriptPanel",
            "callout",
            "metadataBlock",
            "footer",
            "header",
            "unknown"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "sectionKind": {
          "type": "string"
        },
        "ordered": {
          "type": "boolean"
        },
        "listStyle": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableColumn"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableRow"
          }
        },
        "assetRef": {
          "$ref": "#/$defs/id"
        },
        "altText": {
          "type": "string"
        },
        "decorative": {
          "type": "boolean"
        },
        "href": {
          "type": "string"
        },
        "rel": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "linkPurpose": {
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "method": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "inputType": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputOption"
          }
        },
        "term": {
          "$ref": "#/$defs/text"
        },
        "definition": {
          "$ref": "#/$defs/text"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "symbolRef": {
          "$ref": "#/$defs/id"
        },
        "usage": {
          "type": "string",
          "enum": [
            "semantic",
            "decorative",
            "mixed",
            "unknown"
          ]
        },
        "description": {
          "type": "string"
        },
        "diagramType": {
          "type": "string"
        },
        "containsSymbolRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "panelNumber": {
          "type": "integer",
          "minimum": 1
        },
        "folio": {
          "type": "string"
        },
        "calloutType": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "success",
            "danger",
            "note"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadataEntry"
          }
        },
        "rawContent": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "sourceFragment": {
          "type": "string"
        },
        "semanticRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "relationshipRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "annotationRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "sourceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "inference": {
          "$ref": "#/$defs/inference"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "document",
                  "section",
                  "figure",
                  "navigation",
                  "form",
                  "glyphCluster",
                  "manuscriptPanel",
                  "callout",
                  "footer",
                  "header"
                ]
              }
            }
          },
          "then": {
            "required": [
              "children"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "heading"
              }
            }
          },
          "then": {
            "required": [
              "text",
              "level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "paragraph",
                  "quote",
                  "caption"
                ]
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "required": [
              "ordered",
              "children"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "columns",
              "rows"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "assetRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            }
          },
          "then": {
            "required": [
              "text",
              "action"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            }
          },
          "then": {
            "required": [
              "text",
              "href"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            }
          },
          "then": {
            "required": [
              "inputType",
